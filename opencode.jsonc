// OpenCode project-local config for Helm
// Official schema: https://opencode.ai/config.json
//
// Model and provider setup should be configured via:
//   opencode providers (global credentials)
//   -m <provider/model> (per-session override)
// Per-agent model routing not supported in project config yet.

{
  "$schema": "https://opencode.ai/config.json",
  "model": "anthropic/claude-sonnet-4-6",
  "instructions": [
    "AGENTS.md",
    "docs/ai/*.md"
  ],
  "default_agent": "helm-build"
}
