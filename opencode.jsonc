// OpenCode project-local config for Helm (legacy — Cursor is canonical)
// Official schema: https://opencode.ai/config.json
//
// Canonical agents: `.cursor/agents/*.md` — update those for prompt changes.
// Per-agent model routing here: `.opencode/agents/*.md` (transition only).

{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode-go/deepseek-v4-pro",
  "instructions": [
    "AGENTS.md",
    "docs/ai/*.md"
  ],
  "default_agent": "helm-orchestrator",
  "mcp": {
    // Machine-local paths — adjust per developer machine.
    // These resolve to node + @playwright/mcp on Barry's system.
    "playwright": {
      "type": "local",
      "command": [
        "/home/barry/.local/share/mise/installs/node/lts/bin/node",
        "/home/barry/.local/share/mise/installs/node/lts/lib/node_modules/@playwright/mcp/cli.js",
        "--headless",
        "--ignore-https-errors",
        "--viewport-size=1920x1080",
        "--caps=vision,devtools",
        "--isolated"
      ],
      "enabled": true
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true,
      "headers": {
        "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}"
      }
    }
  }
}
